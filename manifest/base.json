{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "optional_permissions": [
    "privacy"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "spanning"
}
