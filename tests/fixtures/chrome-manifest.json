{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "proxy",
    "storage",
    "unlimitedStorage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider",
    "offscreen",
    "activeTab"
  ],
  "optional_permissions": [
    "privacy"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'"
  },
  "incognito": "spanning"
}
