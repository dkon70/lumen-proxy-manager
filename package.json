{
  "name": "lumen-proxy",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:chrome": "vite build --watch --mode chrome",
    "dev:firefox": "vite build --watch --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node scripts/icons.mjs && vite build --mode chrome",
    "build:firefox": "node scripts/icons.mjs && vite build --mode firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint:firefox": "addons-linter dist/firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "npm run build:chrome && node scripts/zip.mjs chrome",
    "zip:firefox": "npm run build:firefox && node scripts/zip.mjs firefox",
    "e2e": "node e2e/run.mjs",
    "e2e:shots": "node e2e/run.mjs --shots",
    "e2e:firefox": "node e2e/firefox.mjs",
    "zip:source": "node scripts/zip.mjs source",
    "store": "npm run build:chrome && node scripts/store.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "^0.1.0",
    "acorn": "^8.19.0",
    "addons-linter": "^10.14.0",
    "puppeteer-core": "^25.14.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
